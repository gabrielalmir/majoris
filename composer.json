{
	"description": "Majoris, a drop-in base of CodeIgniter 3",
	"name": "codeigniter/framework",
	"type": "project",
	"homepage": "https://github.com/gabrielalmir/majoris",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/gabrielalmir/majoris/issues",
		"source": "https://github.com/gabrielalmir/majoris"
	},
	"require": {
		"php": ">=7.4"
	},
	"scripts": {
		"lint": "phpcs",
		"stan": "phpstan analyse --memory-limit=2G --no-progress",
		"test": "phpunit --configuration tests/travis/sqlite.phpunit.xml",
		"check": [
			"@lint",
			"@stan",
			"@test"
		],
		"test:coverage": [
			"@putenv XDEBUG_MODE=coverage",
			"phpunit --color=always --coverage-text --configuration tests/travis/sqlite.phpunit.xml"
		]
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"require-dev": {
		"mikey179/vfsstream": "^1.6.12",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.13",
		"phpcompatibility/php-compatibility": "^10.0@alpha",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^1.12"
	}
}
