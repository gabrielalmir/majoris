<?xml version="1.0"?>
<ruleset name="Majoris">
	<description>One type per file and PHP 7.4 - 8.5 compatibility.</description>

	<file>system</file>
	<file>tests</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>

	<!-- Extensões que o PHP 7 removeu. Os arquivos permanecem; esta leva não os reescreve. -->
	<exclude-pattern>*/system/database/drivers/mysql/*</exclude-pattern>
	<exclude-pattern>*/system/database/drivers/mssql/*</exclude-pattern>
	<exclude-pattern>*/system/database/drivers/ibase/*</exclude-pattern>
	<exclude-pattern>*/system/database/drivers/pdo/subdrivers/pdo_firebird_forge.php</exclude-pattern>
	<!-- mcrypt saiu no PHP 7.2. O OpenSSL no mesmo arquivo continua coberto por teste e pelo PHPStan. -->
	<exclude-pattern>*/system/libraries/Encryption.php</exclude-pattern>
	<!-- oci8 não entra na matriz. Os aliases que o PHP 8.4 removeu ficam para outra leva. -->
	<exclude-pattern>*/system/database/drivers/oci8/*</exclude-pattern>
	<!-- Incluído só quando PHP >= 8. No 7.4 o Session.php carrega OldSessionWrapper.php. -->
	<exclude-pattern>*/system/libraries/Session/PHP8SessionWrapper.php</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-8.5"/>
	<!-- Avisos de depreciação em código fora do roadmap (imagedestroy, mcrypt já excluído, session.sid_*) não derrubam o check. Erro derruba. -->
	<config name="ignore_warnings_on_exit" value="1"/>

	<rule ref="Generic.Files.OneClassPerFile">
		<exclude-pattern>*/system/libraries/Driver\.php$</exclude-pattern>
		<exclude-pattern>*/system/libraries/Xmlrpc\.php$</exclude-pattern>
		<!-- O mock declara CI_DB no mesmo arquivo em que o loader de teste espera. -->
		<exclude-pattern>*/tests/mocks/database/db/driver\.php$</exclude-pattern>
		<!-- DB_result_dummy existe só para o teste de tabela. -->
		<exclude-pattern>*/tests/codeigniter/libraries/Table_test\.php$</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneInterfacePerFile">
		<exclude-pattern>*/system/libraries/Driver\.php$</exclude-pattern>
		<exclude-pattern>*/system/libraries/Xmlrpc\.php$</exclude-pattern>
	</rule>
	<rule ref="Generic.Files.OneTraitPerFile">
		<exclude-pattern>*/system/libraries/Driver\.php$</exclude-pattern>
		<exclude-pattern>*/system/libraries/Xmlrpc\.php$</exclude-pattern>
	</rule>

	<rule ref="PHPCompatibility"/>
</ruleset>
